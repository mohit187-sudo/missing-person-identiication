# ============================================================================
# Missing Person Identification System — environment configuration
# Copy this file to `.env` and fill in values. NEVER commit the real `.env`.
#
# Generate a strong JWT secret (PowerShell):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# (bash): python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# ============================================================================

# --- Core (required in production; safe defaults for local demo) -------------
# development | staging | production
ENVIRONMENT=development
# DEMO_MODE seeds synthetic cases and labels all demo data in the UI.
DEMO_MODE=true
# Comma-separated allowlist of browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the frontend (used in notification links).
FRONTEND_URL=http://localhost:5173

# --- Database ---------------------------------------------------------------
# PostgreSQL (recommended, use docker compose up -d db):
#   DATABASE_URL=postgresql+psycopg://mpis:mpis@localhost:5432/mpis
# SQLite fallback for quick local demo / tests:
DATABASE_URL=sqlite:///./storage/dev.db

# --- Authentication ---------------------------------------------------------
# REQUIRED in production. In development an ephemeral secret is generated with
# a startup warning if left empty.
JWT_SECRET_KEY=
# Access-token lifetime (minutes) and refresh-token lifetime (days).
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- AI / face matching -----------------------------------------------------
# Face backend: opencv_sface (YuNet detector + SFace embeddings) or none.
AI_BACKEND=opencv_sface
# Directory holding the ONNX model weights (see scripts/download_models.py).
AI_MODEL_PATH=./backend/models
AI_MODEL_NAME=opencv_zoo_sface
# Cosine-similarity threshold for reporting potential matches (0..1).
# Tune ONLY on lawfully obtained, representative data. A similarity score is
# NOT the probability that two images show the same person.
AI_MATCH_THRESHOLD=0.55
# Minimum face detection confidence and quality gates.
AI_MIN_FACE_CONFIDENCE=0.6
AI_MIN_FACE_SIZE_PX=64
AI_MAX_BLUR_VARIANCE_BELOW=35.0

# --- Uploads / storage ------------------------------------------------------
# Private storage root for photos, videos and job artifacts.
STORAGE_DIR=./storage
MAX_PHOTO_UPLOAD_MB=8
MAX_VIDEO_UPLOAD_MB=512
# Frame sampling interval (seconds) for CCTV analysis.
VIDEO_FRAME_SAMPLE_SECONDS=1.0

# --- Rate limiting / security ----------------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=120

# --- Email (OPTIONAL). Leave EMAIL_PROVIDER_API_KEY empty to run in
# in-app-notification-only mode (no external provider required).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# --- Object storage (OPTIONAL). Leave empty to use protected local storage.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
