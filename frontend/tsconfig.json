{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "vitest": ["./node_modules/vitest/dist/index.d.ts"],
      "@testing-library/react": ["./node_modules/@testing-library/react"],
      "@testing-library/jest-dom": ["./node_modules/@testing-library/jest-dom"],
      "react-router-dom": ["./node_modules/react-router-dom"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react": ["./node_modules/@types/react"]
    }
  },
  "include": ["src", "../tests/frontend"]
}
